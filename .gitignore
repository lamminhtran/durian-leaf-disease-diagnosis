# Môi trường
.venv/
venv/
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Hệ điều hành / IDE
.DS_Store
.idea/
.vscode/

# Trọng số mô hình.
#
# Mặc định loại trừ vì quá nặng cho git thường, NHƯNG trọng số đang phục vụ thì
# PHẢI đi theo repo khi deploy (Hugging Face Space, Cloud Run build từ nguồn...)
# — thiếu nó thì container khởi động xong vẫn trả 503 mãi.
#
# Hugging Face xử lý tệp lớn bằng git-xet/LFS nên 90MB là bình thường.
*.keras
*.safetensors
# Trọng số nằm ngoài models/ (bản nháp, checkpoint tạm) thì không đưa vào repo.
*.pth
!models/*.pth

# Log
logs/
*.log

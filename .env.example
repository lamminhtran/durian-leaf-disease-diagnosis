# ---- Dịch vụ ----
ENVIRONMENT=production          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json cho production, console khi phát triển

# ---- Mô hình ----
BACKBONE_NAME=caformer_s18.sail_in22k_ft_in1k
MODEL_PATH=models/caformer_s18_best.pth
DEVICE=auto                     # auto | cpu | cuda | mps
IMAGE_SIZE=224
TORCH_NUM_THREADS=0             # 0 = để torch tự quyết; đặt 1-2 khi chạy nhiều worker

# ---- Giới hạn đầu vào ----
MAX_UPLOAD_BYTES=10485760       # 10 MB
MAX_IMAGE_PIXELS=50000000

# ---- Grad-CAM ----
ENABLE_GRADCAM=true
GRADCAM_ALPHA=0.5
# Để trống = tự dò (stages[-1].blocks[-1].norm2, đúng như notebook huấn luyện).
GRADCAM_TARGET_LAYER=
# Khoanh vùng bệnh bằng WSOL, suy ra từ bản đồ nhiệt.
ENABLE_WSOL=true

# ---- Trợ lý AI (OpenRouter) ----
# Lấy khoá tại https://openrouter.ai/keys rồi dán vào đây.
# ĐỂ TRỐNG = tắt hẳn tính năng trò chuyện; phần chẩn đoán vẫn chạy bình thường.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.3
LLM_MAX_HISTORY_MESSAGES=12
# Gửi kèm làm HTTP-Referer để OpenRouter thống kê theo ứng dụng (tuỳ chọn).
PUBLIC_URL=

# ---- Giới hạn tần suất (mỗi tiến trình) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Hạn mức riêng cho chat: mỗi lượt gọi LLM đều tốn tiền nên siết chặt hơn.
CHAT_RATE_LIMIT_REQUESTS=12
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ---- HTTP ----
# Khi chạy công khai, thay '*' bằng danh sách origin cụ thể, cách nhau bằng dấu phẩy.
CORS_ALLOW_ORIGINS=*
# Số lớp proxy tin cậy phía trước. Đặt 1 khi chạy sau nginx; để 0 nếu expose trực tiếp.
TRUSTED_PROXY_COUNT=0
